<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>Orc.Search</AssemblyName>
    <RootNamespace>Orc.Search</RootNamespace>
    <DefaultLanguage>en-US</DefaultLanguage>
    <PackageId>Orc.Search</PackageId>
    <PackageVersion>1.0.0-alpha0001</PackageVersion>
    <Description>Search library.</Description>
    <PackageTags>orc;search;lucene</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <!-- SonarQube requires a project guid -->
    <ProjectGuid>50DBA6E6-31D3-43C8-9D74-0C711185D2BA</ProjectGuid>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Catel.Fody" Version="4.12.0-alpha0121" PrivateAssets="all" />
    <PackageReference Include="Catel.SourceGenerators" Version="1.0.0-alpha0030" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="6.0.0" PrivateAssets="all" /> 
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Lucene.Net" Version="4.8.0-beta00017" PrivateAssets="all" />
    <PackageReference Include="Lucene.Net.QueryParser" Version="4.8.0-beta00017" PrivateAssets="all" />
    <PackageReference Include="MethodTimer.Fody" Version="3.2.3" PrivateAssets="all" />
    <PackageReference Include="Obsolete.Fody" Version="5.3.1" PrivateAssets="all" />
    <!--<PackageReference Include="Orc.FileSystem" Version="5.1.0" />
    <PackageReference Include="Orc.Metadata" Version="5.1.0" />
    <PackageReference Include="Orc.Serialization.Jon" Version="5.1.0" />-->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Orc.FileSystem\src\Orc.FileSystem\Orc.FileSystem.csproj" />
    <ProjectReference Include="..\..\..\Orc.Metadata\src\Orc.Metadata\Orc.Metadata.csproj" />
    <ProjectReference Include="..\..\..\Orc.Serialization\src\Orc.Serialization.Json\Orc.Serialization.Json.csproj" />
  </ItemGroup>

  <ItemGroup Condition=" $(TargetFramework.StartsWith('net8.0')) ">
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
  </ItemGroup>  

  <ItemGroup Condition=" $(TargetFramework.StartsWith('net9.0')) ">
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.11" />
  </ItemGroup>

  <ItemGroup Condition=" $(TargetFramework.StartsWith('net10.0')) ">
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <Import Project="$(MSBuildProjectDirectory)\..\Directory.Build.nullable.props" Condition="Exists('$(MSBuildProjectDirectory)\..\Directory.Build.nullable.props')" />
  <Import Project="$(MSBuildProjectDirectory)\..\Directory.Build.shared.explicit.props" Condition="Exists('$(MSBuildProjectDirectory)\..\Directory.Build.shared.explicit.props')" />
  <Import Project="$(MSBuildProjectDirectory)\..\Directory.Build.shared.mat.props" Condition="Exists('$(MSBuildProjectDirectory)\..\Directory.Build.shared.mat.props')" />
</Project>
